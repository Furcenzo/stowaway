#
# Blocks a commit when a text in the app is missing a translation.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if git diff --cached --name-only | grep -qE '^Sources/.*\.(swift|strings)$'; then
    ./scripts/check-localization.sh || {
        echo "\nCommit stopped: fix the translations above (see CLAUDE.md → Localization)." >&2
        echo "Use 'git commit --no-verify' only if you really need to skip the check." >&2
        exit 1
    }
fi
